# Ex4 -- các định nghĩa phải có trong FreeRTOSConfig.h cho run-time stats

#define configGENERATE_RUN_TIME_STATS            1
#define configUSE_TRACE_FACILITY                 1
#define configUSE_STATS_FORMATTING_FUNCTIONS     1
#define INCLUDE_xSemaphoreGetMutexHolder         1

#define portCONFIGURE_TIMER_FOR_RUN_TIME_STATS()  runtime_stats_timer_init()
#define portGET_RUN_TIME_COUNTER_VALUE()          runtime_stats_timer_value()

# IWDG chạy trên LSI (~40 kHz), KHÔNG phụ thuộc HCLK/TIM4 -- vẫn reset được
# ngay cả khi lõi đang deadlock trên một mutex. Tính reload value cho
# IWDG_TIMEOUT_MS của bạn, ghi phép tính vào REPORT.md:
#   reload = IWDG_TIMEOUT_MS * (LSI_HZ / prescaler) / 1000
